# ---------------------------------------------------------------------------
# Template for .env  ->  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env is git-ignored. NEVER commit it: this repo is public.
# Read only by app/config.py. Every value except TEAM_API_KEY has a default in
# app/config.py, so an outdated .env still starts; a missing key does not.
# New variable? Add it here (with its default) in the same commit + post in #update.
# ---------------------------------------------------------------------------

# --- Secret (the only line you fill in) ------------------------------------
# 5U team key from the kit-card mail. One key for mailbox, portal, gateway, board.
# Old name HACKLOOP_API_KEY is still accepted as a fallback.
TEAM_API_KEY=
# The OpenAI key does NOT go here: it is posted once to the 5U gateway
# (POST /v1/gateway/openai-key). Code only ever uses TEAM_API_KEY.

# --- 5U endpoints and addresses ---------------------------------------------
HACKLOOP_BASE_URL=https://api.start-hack.5u.ai
TEAM_MAILBOX=austrian-power@hackloop.mail
RATEDESK_ADDRESS=ratedesk@hackloop.mail
TRACKING_ADDRESS=tracking@hackloop.mail

# --- Pricing and writable data ----------------------------------------------
# Writable generated data, kept outside tracked snapshots; /data/runtime on Railway.
RUNTIME_DIR=data/runtime
# Optional documented EUR per USD rate for sheets/bids; requires a UTC expiry.
USD_EUR_RATE=
USD_EUR_VALID_UNTIL=
USE_BREAKPOINTS=true
# --- LLM (via the 5U gateway only) -------------------------------------------
# Must be listed by GET /v1/gateway/models and have a price in app/llm_prices.json,
# otherwise its cost is logged as 0.
LLM_MODEL=gpt-5-nano

# --- Runtime -------------------------------------------------------------------
POLL_INTERVAL_S=1.5          # mailbox poll; spec says 1-2 s
DB_PATH=data/forwarder.db    # use data/demo.db for app/ui/demo.py, never the real one
UI_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Background jobs of the UI (task C) --------------------------------------
BOARD_SYNC_EVERY_S=60        # GET /v1/board/me; 5U adds cost points hourly
DEADLINE_CHECK_EVERY_S=10    # marks sessions expired after 6 min without a quote

# --- Online UI (required when the UI is reachable from the internet) --------
UI_USER=team
UI_PASSWORD=                 # empty = no login (local only!)
# On Railway/Render, PORT is set by the platform and wins over UI_PORT.

# --- RFQ agent (task A) ------------------------------------------------------
QUOTE_TARGET_S=100           # send the quote this many s after the RFQ arrived (bids until then)
BID_MAX_WAIT_S=240           # wait at most this long for a missing trucker / only-bid price
