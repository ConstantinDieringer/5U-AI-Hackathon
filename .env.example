# ---------------------------------------------------------------------------
# Template for .env  ->  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env is git-ignored. NEVER commit it: this repo is public.
# Read only by app/config.py. Every value except TEAM_API_KEY has a default in
# app/config.py, so an outdated .env still starts; a missing key does not.
# New variable? Add it here (with its default) in the same commit + post in #update.
# ---------------------------------------------------------------------------

# --- Secret (the only line you fill in) ------------------------------------
# 5U team key from the kit-card mail. One key for mailbox, portal, gateway, board.
# Old name HACKLOOP_API_KEY is still accepted as a fallback.
TEAM_API_KEY=
# Signed mailbox pushes: configure env secret OR the private file returned by webhook_admin.
MAILBOX_WEBHOOK_SECRET=
# Default private file is runtime/mailbox-webhook.secret beside DB_PATH.
# MAILBOX_WEBHOOK_SECRET_FILE=/data/runtime/mailbox-webhook.secret
MAILBOX_WEBHOOK_POLL_INTERVAL_S=30
# shadow records input problems without new automatic replies; enforce blocks pricing
# and asks one question at a time, repeating only after a new incomplete customer reply.
RFQ_VALIDATION_MODE=enforce
# Phishing gate before any reply or action: off | shadow (classify and log only) | enforce.
# enforce quarantines rule-based phishing verdicts; PHISHING_GATE_LLM_MODE caps what an
# LLM-only verdict may do (shadow = log only). Rollback: PHISHING_GATE_MODE=off.
PHISHING_GATE_MODE=enforce
PHISHING_GATE_LLM_MODE=shadow
PHISHING_GATE_MODEL=gpt-5-nano
# mail guard (no LLM): empty/automatic mail and RFQ floods are held, outgoing loops are cut
MAIL_GUARD_ENABLED=true
INBOUND_FLOOD_MAX=3
INBOUND_FLOOD_S=600
OUTBOUND_BURST_MAX=6
OUTBOUND_BURST_S=120
OUTBOUND_SESSION_MAX=15
OUTBOUND_DUPLICATE_S=1800
# The OpenAI key does NOT go here: it is posted once to the 5U gateway
# (POST /v1/gateway/openai-key). Code only ever uses TEAM_API_KEY.

# --- 5U endpoints and addresses ---------------------------------------------
HACKLOOP_BASE_URL=https://api.start-hack.5u.ai
TEAM_MAILBOX=austrian-power@hackloop.mail
RATEDESK_ADDRESS=ratedesk@hackloop.mail
TRACKING_ADDRESS=tracking@hackloop.mail

# --- Pricing and writable data ----------------------------------------------
# Writable generated data, kept outside tracked snapshots; /data/runtime on Railway.
RUNTIME_DIR=data/runtime
# Optional documented EUR per USD rate for sheets/bids; requires a UTC expiry.
USD_EUR_RATE=
USD_EUR_VALID_UNTIL=
USE_BREAKPOINTS=true
# --- LLM (via the 5U gateway only) -------------------------------------------
# Must be listed by GET /v1/gateway/models and have a price in app/llm_prices.json,
# otherwise its cost is logged as 0.
LLM_MODEL=gpt-5-mini
LLM_COMPOSE_MODEL=gpt-5-mini # individual customer wording and grounded conversation references
LLM_REVIEW_MODEL=gpt-5      # dedicated final customer-email style reviewer
EMAIL_REVIEW_ENABLED=false  # extra LLM style reviewer disabled; deterministic send checks stay active
# customers in any language but de/en get the final reply translated (one checked LLM call, original on any doubt).
# Rollback: REPLY_IN_CUSTOMER_LANGUAGE=false
REPLY_IN_CUSTOMER_LANGUAGE=true
TRACKING_NOTICE_CHECK_EVERY_S=30 # recover one missing tracking invitation per interval, no LLM
LLM_MAX_CALLS_PER_SESSION=8 # extraction/composition plus one style review per outgoing customer reply
# cost: gpt-5 costs ~25x gpt-5-nano; one gpt-5 call can cost more than a whole normal quote
LLM_RETRY_MODEL=gpt-5-mini  # repair when the extraction is unusable
LLM_RESCUE_MODEL=gpt-5-mini # thread owner for recovery and workflow decisions
THREAD_RESCUE_ENABLED=true
THREAD_RESCUE_MAX_CALLS=2   # separate persisted recovery budget, with cost accounting
THREAD_RESCUE_MAX_MAILS=8   # rescue prompt: latest mails of the thread (root always kept)
THREAD_RESCUE_BODY_CHARS=2500 # rescue prompt: characters per mail (attachments 2x)
COMPOSE_REPAIR=false        # true = second composer call after a failed check; false = checked template
THREAD_RESCUE_AFTER_S=45    # background takeover of stalled automatic sessions
# Attachments (app/mail/documents.py): pdf/docx/doc/rtf/odt/xlsx/xls/ods/csv/txt/eml are read in
# code. Voice uses Groq, an allowed gateway audio model, then offline Whisper.
SPEECH_MODEL=base           # multilingual offline fallback
SPEECH_MODEL_DIR=           # model cache; Docker sets /opt/whisper (baked in at build)
LLM_VISION_MODEL=           # scanned carrier offers; empty = LLM_MODEL
ATTACHMENT_TRANSCRIPTION=true # false = no speech recognition or scan transcription

# --- Runtime -------------------------------------------------------------------
BUILD_REVISION=unknown      # Railway uses RAILWAY_GIT_COMMIT_SHA automatically
POLL_INTERVAL_S=1.5          # mailbox poll; spec says 1-2 s
DB_PATH=data/forwarder.db    # use data/demo.db for app/ui/demo.py, never the real one
UI_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Background jobs of the UI (task C) --------------------------------------
BOARD_SYNC_EVERY_S=15        # GET /v1/board/me; fast verdict diagnostics
DEADLINE_CHECK_EVERY_S=10    # marks sessions expired after 6 min without a quote

# --- Online UI (required when the UI is reachable from the internet) --------
UI_USER=team
UI_PASSWORD=                 # required before running run.py; use a long unique password
# On Railway/Render, PORT is set by the platform and wins over UI_PORT.

# --- RFQ agent (task A) ------------------------------------------------------
QUOTE_TARGET_S=110           # legacy alias for QUOTE_FULL_SCORE_DEADLINE_S
BID_MAX_WAIT_S=300           # legacy alias for QUOTE_FINAL_DEADLINE_S
QUOTE_FULL_SCORE_DEADLINE_S=110  # aim to send a complete, best-known quote by then
QUOTE_FINAL_DEADLINE_S=300       # absolute processing deadline
MIN_BID_CARRIERS=2
MAX_BID_CARRIERS=5           # email-only airline bid requests per RFQ
MAX_TRUCKER_BIDS=5           # trucker bid requests per RFQ (own cap, does not use airline slots)
PRICE_ADJUST_PCT=0           # % off the computed all-in total; 0 = quote our cost (experimental)
CARRIER_OBSERVATION_TTL_S=3600
ALLOW_INCOMPLETE_DOOR_QUOTE=false
TRUCKER_BALANCE=ratio        # 50/50 pick among trucker AND airline bids: ratio (default,
                             # price/cheapest + time/fastest, matches the board on all 11 door
                             # rounds) | minmax (old rule, 2 bids always tie -> cheaper wins)
SELF_DELIVERY_RECOVERY=true  # true: read the departure from "we deliver to CGN ourselves",
                             # "Wir liefern selbst nach Frankfurt" or "from CGN to DFW" (also in the
                             # answer to our origin question); skips negated sentences, codes in
                             # capitals only
ASK_PICKUP_ZIP=false         # true: a pickup without ZIP or city (signature and other shipments
                             # do not count) asks once for the pickup ZIP instead of pricing
                             # an assumed site; also in shadow mode and the UI emergency draft
CLARIFY_ONCE=false           # true: at most one question per RFQ thread, free-text answers
                             # ("CGN", "Cologne", a ZIP, "gross weight is 85 kg"); no usable
                             # answer -> best quote from real prices before 120 s + attention
CLARIFY_FALLBACK_AFTER_S=45  # CLARIFY_ONCE: seconds after the request to stop waiting
BID_NEXT_BREAK=false         # true: an airline with known portal brackets also gets a bid request
                             # billed at its next weight break; the cheaper offer counts
                             # (round 27: 859 kg at 3.35 €/kg vs 1000 kg at 2.84 €/kg)
CONFLICT_SOURCE_ANSWER=true  # true: "the attached packing specification is correct" (rounds 33 to 35)
                             # answers a mail/attachment weight, volume or pieces conflict with
                             # the attachment's figures ("the figures in my mail" with the mail's)
CUTOFF_QUESTION_NOTICE=true  # true: the fallback quote also answers "latest drop-off time at HAM"
                             # style questions with the unconfirmed-cutoff sentence
TARIFF_ON_READY_DATE=true    # true: a ready date after today prices each airline's sheet valid on
                             # that date when one is ingested (December tariff for 2.12), else
                             # today's sheet; false = validity checked against today only
UNIT_EVIDENCE=true           # true: "2700 lbs gross", "1.2 tonnes gross", "Bruttogewicht", 1,228 /
                             # 1.228 kg when the extraction agrees with one reading, and volume
                             # from "N pieces, each L x W x H cm" count as mail evidence
TOTALS_SAME_LINE=false      # true: a total's label reaches its number across a line break only
                             # after "of"/"is" or ":"/"|"; a table header ending in "Gross weight
                             # (kg)" no longer takes the next row's first cell (Kessler BOM thread)
THOUSANDS_EVIDENCE=false     # true: "1,674 kg" / "1.674 kg" is 1674 kg when a figure of the same
                             # shipment says so (extraction, thread, attachment), or, with none,
                             # when under 10 kg is implausible (pallets, pieces, volume); the same
                             # rule in replies, direct weight answers and the rescue model
CLARIFY_CAP_RESOLVE=false    # true: both questions spent and still open: the one plausible
                             # weight/volume of the thread, else the best quote from what the mail
                             # states (DG only once asked), else no mail, error and top of "Zu tun"
REVISION_NOT_ACCEPTANCE=true  # true: "sounds good, but quote the fastest instead" / "statt" is
                             # not an acceptance: no booking, one question back
ALL_EXCLUDED_NOTICE=true     # true: when the customer's exclusions leave no carrier on the lane,
                             # tell the customer (no price) and flag the session for a person
PREBOOK_ANSWER=false         # true: a reply to our quote that asks about the quoted option
                             # (fastest, arrival, pickup, airline, validity, ...) is answered
                             # from the stored quote with a go-ahead question; never books.
                             # Counts with the follow-up nudges against FOLLOWUP_MAX
# SERVED_LANES_TTL_S=3600    # deprecated alias for CARRIER_OBSERVATION_TTL_S
RFQ_WATCHDOG=false           # true: an RFQ thread still without our quote RFQ_WATCHDOG_AFTER_S
                             # after arrival gets the best quote real prices allow (sheets,
                             # portal, bids already in). Never a second quote, never for a paused
                             # or taken-over session, never on open dangerous goods, an excluded
                             # carrier or phishing; no real price -> nothing sent + alert
RFQ_WATCHDOG_AFTER_S=200     # seconds after the RFQ arrived (a quote at 200 s still earns ~10/15)
RFQ_INTERVAL_S=364           # deploy gate: fallback spacing of RFQs when too few arrivals are known
DEPLOY_GATE_MARGIN_S=90      # deploy gate: green only while the next RFQ is further away than this

# ---- Slack #sos alerts (app/ui/alerts.py) --------------------------------------------
# Incoming webhook for #sos. Unset = no alerts. Never commit the real URL.
SLACK_SOS_WEBHOOK=
PUBLIC_URL=https://5u-ai-hackathon-production.up.railway.app

# ---- Voice attachments: Groq -> allowed gateway audio -> offline CPU Whisper ----
# Create a Groq Free account and set the secret only in Railway/local .env.
# Do not put the endpoint URL here. No account creation or paid upgrade is automatic.
GROQ_API_KEY=
GROQ_AUDIO_MODEL=whisper-large-v3
LLM_AUDIO_MODEL=             # empty = auto-select an allowed audio-capable gateway model
AUDIO_TIMEOUT_S=60          # total recognition budget across providers for one file
LOCAL_AUDIO_ENABLED=true
LOCAL_AUDIO_MODEL=          # defaults to SPEECH_MODEL; overrides must be preloaded
